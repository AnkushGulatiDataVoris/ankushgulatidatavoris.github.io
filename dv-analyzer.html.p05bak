<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Instant Data Analyzer — Datavoris</title>
<meta name="description" content="Upload a small dataset and get instant analytics — entirely in your browser. Your data never leaves your device."/>
<link rel="icon" type="image/svg+xml" href="favicon.svg?v=2"/>
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png?v=2"/>
<link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png?v=2"/>
<link rel="shortcut icon" href="favicon.ico?v=2"/>
<link rel="apple-touch-icon" href="favicon-preview-256.png?v=2"/>
<meta name="theme-color" content="#0a1628"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
:root{
  --n9:#050e1f;--n8:#0a1628;--n7:#0f1e3d;--n6:#162444;--n5:#1d2f54;--n4:#2a3f6b;--n3:#3d5585;
  --cyan:#00d4ff;--cdim:rgba(0,212,255,0.1);--cglow:rgba(0,212,255,0.25);
  --amber:#f59e0b;--adim:rgba(245,158,11,0.1);--em:#10d9a0;--rose:#fb7185;--blue:#5b9dff;
  --wh:#f8faff;--off:#eef2fa;--card:#fff;
  --t1:#f0f6ff;--t3:#c8d8f0;--t5:#7a90b8;--t7:#3d5585;
  --ow9:#080e1e;--ow7:#1a2744;--ow5:#4a607e;--ow3:#7a90b8;
  --bn:rgba(255,255,255,0.07);--bw:rgba(8,14,30,0.1);
  --r:14px;--rsm:9px;--rxl:24px;
  --fd:'Space Grotesk',sans-serif;--fb:'Inter',sans-serif;
  --ease:cubic-bezier(0.16,1,0.3,1);
}
html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased;}
body{font-family:var(--fb);background:var(--wh);color:var(--ow9);min-height:100vh;display:flex;flex-direction:column;align-items:center;overflow-x:hidden;}

/* NAV — matches dv-style.css .site-nav exactly */
.nav{width:100%;background:var(--n8);border-bottom:1px solid var(--bn);position:sticky;top:0;z-index:200;backdrop-filter:blur(20px);}
.nav-container{width:100%;max-width:1180px;margin:0 auto;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;height:62px;gap:2rem;}
.brand{font-family:var(--fd);font-size:1.15rem;font-weight:800;color:var(--t1);letter-spacing:-0.03em;display:inline-flex;align-items:center;gap:0.6rem;text-decoration:none;flex-shrink:0;}
.bmark{width:34px;height:34px;border-radius:9px;background:var(--n9);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(0,212,255,0.3);}
.bmark svg{width:72%;height:72%;display:block;}
.nav-links{display:flex;align-items:center;gap:0.2rem;}
.nav-links a{font-family:var(--fb);font-size:0.85rem;color:var(--t5);text-decoration:none;padding:0.4rem 0.85rem;border-radius:7px;transition:color 0.15s,background 0.15s;display:inline-flex;align-items:center;justify-content:space-between;gap:0.5rem;}
.nav-links a:hover{color:var(--t1);background:rgba(255,255,255,0.06);}
.nav-links a.active{color:var(--cyan);}
.nav-cta-mobile{display:none;}
.hire-btn{display:inline-flex;align-items:center;gap:6px;line-height:1.7;background:var(--cyan);color:var(--n9);font-family:var(--fb);font-size:0.82rem;font-weight:700;padding:0.55rem 1.2rem;border-radius:999px;text-decoration:none;border:none;cursor:pointer;flex-shrink:0;box-shadow:0 6px 20px rgba(0,212,255,0.25);transition:transform 0.15s var(--ease),box-shadow 0.25s,opacity 0.15s;letter-spacing:0.01em;white-space:nowrap;}
.hire-btn:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(0,212,255,0.4);}
.nav-burger{display:none;width:42px;height:42px;border-radius:10px;background:transparent;border:1px solid rgba(255,255,255,0.12);color:var(--t1);align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;padding:0;transition:background 0.15s,border-color 0.15s;}
.nav-burger:hover{background:rgba(255,255,255,0.06);border-color:rgba(0,212,255,0.3);}
.nav-burger svg{width:18px;height:18px;}
.nav-burger .x-icon{display:none;}
.nav-burger.open .menu-icon{display:none;}
.nav-burger.open .x-icon{display:block;}
.nav-backdrop{position:fixed;inset:62px 0 0 0;background:rgba(5,14,31,0.55);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);opacity:0;pointer-events:none;transition:opacity 0.25s var(--ease);z-index:198;}
.nav-backdrop.open{opacity:1;pointer-events:auto;}
@media(max-width:768px){
  .nav-container{gap:0.6rem;padding:0 1.25rem;}
  .hire-btn{display:none;}
  .nav-burger{display:inline-flex;margin-left:auto;}
  .nav-links{position:fixed;top:62px;right:0;left:0;flex-direction:column;align-items:stretch;gap:0;background:var(--n9);border-bottom:1px solid rgba(255,255,255,0.08);padding:0 1.25rem;margin-left:0;max-height:0;overflow:hidden;transition:max-height 0.3s var(--ease),padding 0.3s var(--ease);z-index:199;box-shadow:0 16px 32px rgba(0,0,0,0.4);}
  .nav-links.open{max-height:640px;padding:0.5rem 1.25rem 1.2rem;}
  .nav-links a{padding:0.9rem 0.6rem;border-radius:8px;font-size:0.95rem;color:#e8eefc;justify-content:space-between;}
  .nav-links a:not(:last-of-type){border-bottom:1px solid rgba(255,255,255,0.05);}
  .nav-links a::after{content:"→";color:var(--t7);font-size:0.95rem;transition:color 0.15s,transform 0.15s;}
  .nav-links a:hover::after,.nav-links a.active::after{color:var(--cyan);transform:translateX(3px);}
  .nav-cta-mobile{display:block;margin-top:0.5rem;padding-top:0.85rem;border-top:1px solid rgba(255,255,255,0.1);}
  .nav-cta-mobile a{display:flex;align-items:center;justify-content:center;background:var(--cyan);color:var(--n9);font-weight:700;border-radius:999px;padding:0.8rem 1rem;text-decoration:none;font-size:0.92rem;}
  .nav-cta-mobile a::after{display:none;}
}

.main{width:100%;max-width:980px;padding:2.5rem 1.5rem 8rem;}
.fade{animation:fu 0.5s var(--ease) both;}
@keyframes fu{from{opacity:0;transform:translateY(16px);}to{opacity:1;transform:translateY(0);}}

.page-eyebrow{font-size:0.7rem;font-weight:600;text-transform:uppercase;letter-spacing:0.15em;color:var(--cyan);background:var(--cdim);border:1px solid rgba(0,212,255,0.2);border-radius:999px;padding:0.25rem 0.85rem;display:inline-flex;margin-bottom:1rem;}
.page-title{font-family:var(--fd);font-size:clamp(1.8rem,3.5vw,2.5rem);font-weight:800;color:var(--ow9);letter-spacing:-0.03em;line-height:1.1;margin-bottom:0.6rem;}
.page-title em{font-style:normal;background:linear-gradient(135deg,var(--cyan),var(--blue));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.page-sub{font-size:0.95rem;color:var(--ow5);line-height:1.75;margin-bottom:1.5rem;max-width:640px;}

/* PRIVACY BANNER */
.privacy{display:inline-flex;align-items:center;gap:0.6rem;font-size:0.82rem;color:#047857;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:999px;padding:0.45rem 1rem;margin-bottom:2rem;}
.privacy svg{width:15px;height:15px;}

/* DROP ZONE */
.drop{border:2px dashed rgba(0,212,255,0.4);border-radius:var(--rxl);background:linear-gradient(180deg,rgba(0,212,255,0.03),transparent);padding:3.5rem 2rem;text-align:center;cursor:pointer;transition:border-color 0.2s,background 0.2s,transform 0.2s;position:relative;overflow:hidden;}
.drop:hover{border-color:var(--cyan);background:rgba(0,212,255,0.05);}
.drop.drag{border-color:var(--cyan);background:rgba(0,212,255,0.08);transform:scale(1.01);}
.drop-icon{width:64px;height:64px;margin:0 auto 1.2rem;border-radius:16px;background:var(--n8);display:flex;align-items:center;justify-content:center;box-shadow:0 12px 30px rgba(0,212,255,0.2);}
.drop-icon svg{width:30px;height:30px;}
.drop-title{font-family:var(--fd);font-size:1.25rem;font-weight:800;color:var(--ow9);margin-bottom:0.4rem;letter-spacing:-0.02em;}
.drop-sub{font-size:0.88rem;color:var(--ow5);line-height:1.6;margin-bottom:1.3rem;}
.drop-btn{display:inline-flex;align-items:center;gap:7px;background:var(--cyan);color:var(--n9);font-family:var(--fb);font-size:0.88rem;font-weight:700;padding:0.7rem 1.5rem;border-radius:999px;border:none;cursor:pointer;box-shadow:0 4px 16px var(--cglow);}
.drop-formats{font-size:0.72rem;color:var(--ow3);margin-top:1rem;letter-spacing:0.04em;}
.sample-link{margin-top:1.4rem;font-size:0.8rem;color:var(--ow5);}
.sample-link a{color:var(--cyan);font-weight:600;text-decoration:none;cursor:pointer;}
.sample-link a:hover{text-decoration:underline;}

/* RESULTS */
.results{display:none;margin-top:1rem;}
.sec-label{font-size:0.68rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--ow3);margin:2rem 0 1rem;display:flex;align-items:center;gap:10px;}
.sec-label::after{content:'';flex:1;height:1px;background:var(--bw);}

/* file summary bar */
.file-bar{display:flex;align-items:center;justify-content:space-between;gap:1rem;background:var(--n8);border-radius:var(--r);padding:1rem 1.3rem;flex-wrap:wrap;}
.file-bar-left{display:flex;align-items:center;gap:0.8rem;min-width:0;}
.file-ic{width:38px;height:38px;border-radius:9px;background:rgba(0,212,255,0.15);display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;color:var(--cyan);}
.file-ic svg,.es-tag svg,.fh-ic svg,.rm-ic svg{stroke:currentColor;fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;display:inline-block;vertical-align:middle;}
.file-ic svg{width:19px;height:19px;}
.es-tag svg,.fh-ic svg,.rm-ic svg{width:14px;height:14px;}
.file-nm{font-family:var(--fd);font-weight:700;color:var(--t1);font-size:0.95rem;letter-spacing:-0.01em;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.file-meta{font-size:0.76rem;color:var(--t5);margin-top:1px;}
.file-reset{background:transparent;border:1px solid var(--bn);color:var(--t3);font-size:0.78rem;font-weight:600;padding:0.4rem 0.9rem;border-radius:999px;cursor:pointer;font-family:var(--fb);transition:all 0.15s;}
.file-reset:hover{border-color:var(--cyan);color:var(--cyan);}

/* stat cards */
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:0.8rem;}
.kpi{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1.1rem 1.1rem;}
.kpi-n{font-family:var(--fd);font-size:1.7rem;font-weight:900;color:var(--ow9);letter-spacing:-0.03em;line-height:1;}
.kpi-l{font-size:0.72rem;color:var(--ow3);text-transform:uppercase;letter-spacing:0.08em;margin-top:0.4rem;}

/* health */
.health{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1.4rem 1.5rem;display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;}
.health-ring{--p:0;width:78px;height:78px;border-radius:50%;flex-shrink:0;background:conic-gradient(var(--cyan) calc(var(--p)*1%),var(--off) 0);display:flex;align-items:center;justify-content:center;position:relative;}
.health-ring::before{content:'';position:absolute;inset:8px;border-radius:50%;background:var(--card);}
.health-ring span{position:relative;font-family:var(--fd);font-weight:900;font-size:1.2rem;color:var(--ow9);}
.health-txt{flex:1;min-width:200px;}
.health-txt h3{font-family:var(--fd);font-size:1.05rem;color:var(--ow9);margin-bottom:0.3rem;}
.health-txt p{font-size:0.85rem;color:var(--ow5);line-height:1.6;}

/* column table */
.col-table{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);overflow:hidden;}
.col-hdr,.col-row{display:grid;grid-template-columns:1.6fr 0.9fr 0.7fr 2fr;gap:1rem;padding:0.8rem 1.3rem;align-items:center;}
.col-hdr{background:var(--off);font-size:0.66rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--ow3);}
.col-row{border-top:1px solid var(--bw);font-size:0.84rem;}
.col-row:hover{background:var(--off);}
.col-nm{font-weight:600;color:var(--ow9);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.type-pill{font-size:0.68rem;font-weight:700;padding:0.18rem 0.6rem;border-radius:999px;display:inline-flex;letter-spacing:0.03em;}
.type-num{background:rgba(0,212,255,0.12);color:#0284a8;}
.type-cat{background:rgba(91,157,255,0.14);color:#3b5fb0;}
.type-date{background:rgba(245,158,11,0.14);color:#92600b;}
.type-txt{background:rgba(122,144,184,0.16);color:#475569;}
.col-miss{font-size:0.8rem;}
.miss-ok{color:#059669;}.miss-warn{color:#d97706;}.miss-bad{color:#dc2626;}
.spark{display:flex;align-items:flex-end;gap:2px;height:30px;}
.spark i{flex:1;background:linear-gradient(to top,var(--cyan),var(--blue));border-radius:1px;min-height:2px;opacity:0.85;}
.col-stat{font-size:0.75rem;color:var(--ow5);line-height:1.4;}

/* charts */
.chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;}
.chart-card{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1.3rem;}
.chart-card h4{font-family:var(--fd);font-size:0.92rem;color:var(--ow9);margin-bottom:0.2rem;}
.chart-card .ch-sub{font-size:0.74rem;color:var(--ow3);margin-bottom:1rem;}
.chart-wrap{position:relative;height:240px;}

/* insights */
.insight-list{display:flex;flex-direction:column;gap:0.7rem;}
/* HEADLINES — priority findings strip */
.headlines{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0.7rem;margin-bottom:1.1rem;}
.headline{background:var(--card);border:1px solid var(--bw);border-left:3px solid var(--cyan);border-radius:var(--r);padding:0.9rem 1.05rem 0.95rem;display:flex;flex-direction:column;gap:0.35rem;position:relative;}
.headline.critical{border-left-color:#dc2626;background:linear-gradient(180deg,#fef2f2 0,#fff 60%);}
.headline.warn{border-left-color:#f59e0b;background:linear-gradient(180deg,#fffbeb 0,#fff 60%);}
.headline.good{border-left-color:#10b981;background:linear-gradient(180deg,#ecfdf5 0,#fff 60%);}
.headline-tag{display:inline-flex;align-items:center;gap:5px;font-size:0.6rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;}
.headline.critical .headline-tag{color:#b91c1c;}
.headline.warn .headline-tag{color:#92400e;}
.headline.good .headline-tag{color:#047857;}
.headline-tag::before{content:'';width:7px;height:7px;border-radius:50%;background:currentColor;}
.headline-text{font-size:0.86rem;line-height:1.55;color:var(--ow7);font-weight:500;}
.headline-text b{color:var(--ow9);font-weight:700;}

/* OUTLIERS card */
.outliers{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1.3rem 1.4rem;margin-bottom:1.1rem;}
.outliers-head{display:flex;align-items:flex-start;justify-content:space-between;gap:0.6rem;margin-bottom:0.9rem;flex-wrap:wrap;}
.outliers-title{font-family:var(--fd);font-size:1rem;font-weight:800;color:var(--ow9);letter-spacing:-0.02em;}
.outliers-sub{font-size:0.78rem;color:var(--ow5);line-height:1.5;margin-top:0.2rem;}
.outliers-pill{font-size:0.62rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:#92400e;background:#fffbeb;border:1px solid #fde68a;border-radius:999px;padding:0.2rem 0.7rem;align-self:flex-start;}
.outliers-list{display:flex;flex-direction:column;gap:0.55rem;}
.outlier-row{display:grid;grid-template-columns:1fr auto auto;gap:0.7rem;align-items:center;background:var(--off);border-radius:var(--rsm);padding:0.65rem 0.85rem;border:1px solid var(--bw);}
.outlier-col{font-size:0.8rem;color:var(--ow7);font-weight:600;}
.outlier-col .ot-meta{font-size:0.7rem;color:var(--ow3);margin-top:2px;font-weight:400;}
.outlier-val{font-family:var(--fd);font-size:0.95rem;font-weight:800;color:var(--ow9);letter-spacing:-0.02em;}
.outlier-delta{font-size:0.7rem;font-weight:700;padding:0.18rem 0.55rem;border-radius:999px;background:#fef3c7;color:#92400e;}
.outlier-delta.hi{background:#fee2e2;color:#b91c1c;}
.outliers-empty{font-size:0.83rem;color:var(--ow5);padding:0.6rem 0;}

/* AUTOMATION-VALUE callout */
.autoval{background:linear-gradient(135deg,#062f1d 0%,#0a1628 60%);border-radius:var(--r);padding:1.7rem 1.6rem;color:#dce8ff;margin-bottom:1.1rem;position:relative;overflow:hidden;border:1px solid rgba(16,217,160,0.25);}
.autoval::before{content:'';position:absolute;top:-50px;right:-40px;width:240px;height:240px;background:radial-gradient(circle,rgba(16,217,160,0.18),transparent 65%);}
.autoval-tag{display:inline-flex;align-items:center;gap:0.4rem;font-size:0.62rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#10d9a0;background:rgba(16,217,160,0.12);border:1px solid rgba(16,217,160,0.3);border-radius:999px;padding:0.25rem 0.8rem;position:relative;z-index:1;}
.autoval h3{font-family:var(--fd);font-size:1.15rem;font-weight:800;color:#fff;letter-spacing:-0.02em;margin:0.7rem 0 0.5rem;position:relative;z-index:1;}
.autoval-figure{font-family:var(--fd);font-size:2.4rem;font-weight:900;color:#10d9a0;letter-spacing:-0.04em;line-height:1;margin-bottom:0.4rem;position:relative;z-index:1;}
.autoval-figure sub{font-size:0.8rem;color:rgba(16,217,160,0.7);font-family:var(--fb);font-weight:500;vertical-align:baseline;}
.autoval-body{font-size:0.9rem;line-height:1.7;color:rgba(220,232,255,0.85);max-width:560px;position:relative;z-index:1;margin-bottom:1rem;}
.autoval-body b{color:#fff;font-weight:600;}
.autoval-pills{display:flex;flex-wrap:wrap;gap:0.45rem;position:relative;z-index:1;margin-bottom:1.1rem;}
.autoval-pill{font-size:0.72rem;color:rgba(220,232,255,0.85);background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.08);border-radius:999px;padding:0.3rem 0.85rem;font-weight:500;}
.autoval-pill b{color:#10d9a0;font-weight:700;}
.autoval-cta{display:inline-flex;align-items:center;gap:6px;background:#10d9a0;color:#062f1d;font-family:var(--fb);font-size:0.86rem;font-weight:700;padding:0.65rem 1.4rem;border-radius:999px;text-decoration:none;position:relative;z-index:1;transition:transform 0.15s,box-shadow 0.2s;box-shadow:0 4px 14px rgba(16,217,160,0.25);}
.autoval-cta:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(16,217,160,0.35);}
.autoval-note{font-size:0.7rem;color:rgba(220,232,255,0.5);margin-top:0.85rem;font-style:italic;position:relative;z-index:1;}

.exec-summary{background:linear-gradient(135deg,#0a1628,#0f1e3d);border-radius:var(--r);padding:1.6rem 1.8rem;position:relative;overflow:hidden;border:1px solid rgba(0,212,255,0.2);}
.exec-summary::before{content:'';position:absolute;top:-40px;right:-30px;width:200px;height:200px;background:radial-gradient(circle,rgba(0,212,255,0.12),transparent 65%);}
.exec-summary .es-tag{font-size:0.66rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:var(--cyan);margin-bottom:0.7rem;display:flex;align-items:center;gap:7px;position:relative;z-index:1;}
.exec-summary p{font-size:0.95rem;line-height:1.75;color:#dce8ff;position:relative;z-index:1;margin:0;}
.exec-summary p b{color:#fff;font-weight:700;}
.exec-summary .es-cyan{color:var(--cyan);font-weight:600;}
.insight{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1rem 1.2rem;display:flex;gap:0.85rem;align-items:flex-start;border-left:3px solid var(--cyan);}
.insight.warn{border-left-color:var(--amber);}
.insight.good{border-left-color:var(--em);}
.insight.info{border-left-color:var(--blue);}
.insight-ic{font-size:1.1rem;flex-shrink:0;margin-top:1px;}
.insight-tx{font-size:0.86rem;color:var(--ow7);line-height:1.6;}
.insight-tx b{color:var(--ow9);font-weight:700;}

/* correlation */
.corr-wrap{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1.4rem;overflow-x:auto;}
.corr-grid{display:grid;gap:3px;margin:0 auto;width:max-content;}
.corr-cell{width:46px;height:46px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:0.66rem;font-weight:700;}
.corr-lbl{font-size:0.66rem;color:var(--ow5);display:flex;align-items:center;justify-content:center;text-align:center;padding:2px;font-weight:600;}
.corr-lbl.v{writing-mode:vertical-rl;transform:rotate(180deg);}

/* preview table */
.prev-wrap{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);overflow:auto;max-height:340px;}
table.prev{border-collapse:collapse;width:100%;font-size:0.8rem;}
table.prev th{position:sticky;top:0;background:var(--n8);color:var(--t1);font-weight:700;text-align:left;padding:0.6rem 0.9rem;white-space:nowrap;font-size:0.72rem;letter-spacing:0.04em;}
table.prev td{padding:0.5rem 0.9rem;border-top:1px solid var(--bw);color:var(--ow7);white-space:nowrap;}
table.prev tr:hover td{background:var(--off);}

/* CTA */
.cta{background:var(--n8);border-radius:var(--rxl);padding:2.8rem 2.5rem;text-align:center;position:relative;overflow:hidden;margin-top:2.5rem;}
.cta::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--cyan),var(--blue),var(--cyan));background-size:200% auto;animation:sh 3s linear infinite;}
@keyframes sh{to{background-position:200% center;}}
.cta h2{font-family:var(--fd);font-size:clamp(1.4rem,3vw,2rem);font-weight:800;color:var(--t1);letter-spacing:-0.03em;margin-bottom:0.7rem;}
.cta p{font-size:0.92rem;color:var(--t5);max-width:520px;margin:0 auto 1.8rem;line-height:1.7;}
.cta-actions{display:flex;gap:0.9rem;justify-content:center;flex-wrap:wrap;}
.btn-cy{display:inline-flex;align-items:center;gap:6px;background:var(--cyan);color:var(--n9);font-family:var(--fb);font-size:0.88rem;font-weight:700;padding:0.72rem 1.6rem;border-radius:999px;text-decoration:none;border:none;cursor:pointer;box-shadow:0 4px 16px var(--cglow);}
.btn-ol{display:inline-flex;align-items:center;gap:6px;background:transparent;color:var(--t1);font-size:0.88rem;font-weight:500;padding:0.72rem 1.5rem;border-radius:999px;border:1px solid var(--bn);text-decoration:none;cursor:pointer;}

.err{display:none;background:#fef2f2;border:1px solid #fecaca;color:#b91c1c;border-radius:var(--r);padding:1rem 1.2rem;font-size:0.86rem;margin-top:1rem;}
.footer{font-size:0.75rem;color:var(--ow3);text-align:center;margin-top:2.5rem;}

/* PROCESSING OVERLAY */
.anz-proc{position:fixed;inset:62px 0 0 0;z-index:150;background:rgba(248,250,255,0.97);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;padding:1.5rem;overflow:hidden;}
.anz-proc.show{display:flex;animation:anzFade 0.35s ease both;}
@keyframes anzFade{from{opacity:0;}to{opacity:1;}}
.anz-proc::before{content:'';position:absolute;inset:0;background-image:radial-gradient(rgba(0,212,255,0.08) 1px,transparent 1px);background-size:32px 32px;opacity:0.5;pointer-events:none;}
.anz-proc-inner{display:flex;flex-direction:column;align-items:center;gap:1.6rem;width:100%;max-width:460px;position:relative;z-index:1;}
.anz-brand-pill{display:inline-flex;align-items:center;gap:0.5rem;font-size:0.68rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--cyan);background:var(--cdim);border:1px solid rgba(0,212,255,0.2);border-radius:999px;padding:0.3rem 0.9rem;}
.anz-brand-pill::before{content:'';width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 4px rgba(0,212,255,0.15);animation:anzPulse 1.2s ease-in-out infinite;}
.anz-orb{position:relative;width:140px;height:140px;display:flex;align-items:center;justify-content:center;}
.anz-orb svg.anz-ring{position:absolute;inset:0;width:100%;height:100%;}
.anz-orb svg.anz-ring.outer{transform:rotate(-90deg);}
.anz-orb svg.anz-ring.inner{transform:rotate(90deg);animation:anzSpin 3.2s linear infinite;}
@keyframes anzSpin{to{transform:rotate(450deg);}}
.anz-ring-bg{fill:none;stroke:rgba(0,212,255,0.1);stroke-width:5;}
.anz-ring-fg{fill:none;stroke:url(#anzGrad);stroke-width:5;stroke-linecap:round;stroke-dasharray:402.124;stroke-dashoffset:402.124;transition:stroke-dashoffset 0.5s cubic-bezier(0.16,1,0.3,1);}
.anz-ring-orbit{fill:none;stroke:rgba(0,212,255,0.35);stroke-width:2;stroke-dasharray:6 14;stroke-linecap:round;}
.anz-pct{position:absolute;top:50%;left:50%;transform:translate(-50%,calc(-50% - 8px));font-family:var(--fd);font-size:1.85rem;font-weight:900;color:var(--ow9);letter-spacing:-0.04em;z-index:2;line-height:1;text-align:center;display:flex;flex-direction:column;align-items:center;}
.anz-pct .pct-sub{font-family:var(--fb);font-size:0.6rem;font-weight:600;color:var(--ow3);letter-spacing:0.14em;text-transform:uppercase;margin-top:0.4rem;line-height:1;}
.anz-head-wrap{display:flex;flex-direction:column;align-items:center;gap:0.45rem;max-width:420px;margin:0 auto;}
.anz-head{font-family:var(--fd);font-size:1.4rem;font-weight:800;color:var(--ow9);letter-spacing:-0.02em;text-align:center;line-height:1.25;}
.anz-sub{font-size:0.83rem;color:var(--ow5);text-align:center;line-height:1.55;margin:0;}
.anz-steps{display:flex;flex-direction:column;gap:0.45rem;width:100%;text-align:left;}
.anz-step{display:flex;align-items:center;gap:0.75rem;font-size:0.86rem;color:var(--ow3);padding:0.6rem 0.9rem;border-radius:var(--rsm);background:var(--card);border:1px solid var(--bw);transition:all 0.3s;opacity:0.5;transform:translateY(4px);}
.anz-step.active{opacity:1;transform:translateY(0);color:var(--ow9);border-color:rgba(0,212,255,0.4);background:rgba(0,212,255,0.04);box-shadow:0 4px 14px rgba(0,212,255,0.08);}
.anz-step.done{opacity:1;transform:translateY(0);color:var(--ow7);}
.anz-tick{width:22px;height:22px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:0;background:var(--off);color:var(--ow3);border:1.5px solid var(--bw);transition:all 0.3s;}
.anz-tick svg{width:11px;height:11px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;}
.anz-step.active .anz-tick{background:var(--cyan);border-color:var(--cyan);color:var(--n9);box-shadow:0 0 0 4px var(--cdim);}
.anz-step.active .anz-tick svg{display:none;}
.anz-step.active .anz-tick::after{content:'';width:7px;height:7px;border-radius:50%;background:var(--n9);animation:anzPulse 1s infinite;}
.anz-step.done .anz-tick{background:#ecfdf5;border-color:#10b981;color:#059669;font-size:0.7rem;font-weight:800;}
.anz-step.done .anz-tick svg{display:none;}
.anz-step.done .anz-tick::after{content:'✓';font-family:var(--fb);}
@keyframes anzPulse{0%,100%{opacity:1;transform:scale(1);}50%{opacity:0.4;transform:scale(0.7);}}
.anz-counters{display:grid;grid-template-columns:repeat(4,1fr);gap:0.6rem;width:100%;margin-top:0.3rem;}
.anz-counter{background:var(--card);border:1px solid var(--bw);border-radius:var(--rsm);padding:0.65rem 0.5rem;text-align:center;transition:border-color 0.25s,background 0.25s;}
.anz-counter.live{border-color:rgba(0,212,255,0.35);background:rgba(0,212,255,0.04);}
.anz-counter-n{font-family:var(--fd);font-size:1.05rem;font-weight:800;color:var(--ow9);letter-spacing:-0.03em;line-height:1;min-height:1em;}
.anz-counter-l{font-size:0.6rem;font-weight:600;color:var(--ow3);text-transform:uppercase;letter-spacing:0.08em;margin-top:0.3rem;}
.anz-priv{display:inline-flex;align-items:center;gap:0.45rem;font-size:0.74rem;color:#047857;background:#ecfdf5;border:1px solid #a7f3d0;border-radius:999px;padding:0.4rem 0.95rem;font-weight:500;}
.anz-priv svg{width:13px;height:13px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
@media(max-height:760px){
  .anz-proc{padding:1.5rem 1.5rem 2rem;}
  .anz-proc-inner{gap:1.1rem;}
  .anz-orb{width:104px;height:104px;}
  .anz-pct{font-size:1.4rem;}
  .anz-pct .pct-sub{font-size:0.55rem;}
  .anz-head{font-size:1.15rem;}
  .anz-sub{font-size:0.78rem;}
  .anz-step{padding:0.45rem 0.8rem;font-size:0.8rem;}
  .anz-step .anz-tick{width:18px;height:18px;}
  .anz-counter{padding:0.45rem 0.35rem;}
  .anz-counter-n{font-size:0.92rem;}
}
@media(max-width:520px){
  .anz-counters{grid-template-columns:repeat(2,1fr);}
}

/* ── POWER BI-STYLE DASHBOARD ── */
.dash{display:grid;grid-template-columns:210px 1fr;gap:1rem;margin-top:1rem;align-items:start;}
.dash-filters{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1.1rem 1rem;position:sticky;top:78px;}
.dash-filters-head{display:flex;align-items:center;justify-content:space-between;width:100%;background:none;border:none;padding:0;cursor:default;font-family:var(--fd);font-size:0.82rem;font-weight:800;color:var(--ow9);margin-bottom:0.2rem;}
.dash-filters-head .fh-ic{margin-right:6px;}
.dash-filters-head .fh-chev{display:none;color:var(--ow5);font-size:0.9rem;}
.dash-filters .fsub{font-size:0.7rem;color:var(--ow3);margin-bottom:1rem;}
.filter-group{margin-bottom:1.1rem;}
.filter-group .fg-label{font-size:0.68rem;font-weight:700;letter-spacing:0.06em;text-transform:uppercase;color:var(--ow5);margin-bottom:0.5rem;}
.filter-opt{display:flex;align-items:center;gap:7px;font-size:0.8rem;color:var(--ow7);padding:0.28rem 0.4rem;border-radius:6px;cursor:pointer;transition:background 0.12s;}
.filter-opt:hover{background:var(--off);}
.filter-opt input{accent-color:var(--cyan);cursor:pointer;width:14px;height:14px;flex-shrink:0;}
.filter-opt .cnt{margin-left:auto;font-size:0.68rem;color:var(--ow3);}
.filter-reset{width:100%;background:transparent;border:1px solid var(--bw);color:var(--ow5);font-size:0.75rem;font-weight:600;padding:0.45rem;border-radius:var(--rsm);cursor:pointer;font-family:var(--fb);transition:all 0.15s;}
.filter-reset:hover{border-color:var(--cyan);color:var(--cyan);}
.dash-main{min-width:0;}
.dash-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:0.7rem;margin-bottom:1rem;}
.dash-kpi{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:0.9rem 1rem;border-top:3px solid var(--cyan);}
.dash-kpi:nth-child(2){border-top-color:#5b9dff;}
.dash-kpi:nth-child(3){border-top-color:#10d9a0;}
.dash-kpi:nth-child(4){border-top-color:#f59e0b;}
.dash-kpi .k-n{font-family:var(--fd);font-size:1.4rem;font-weight:900;color:var(--ow9);letter-spacing:-0.02em;line-height:1.1;}
.dash-kpi .k-l{font-size:0.68rem;color:var(--ow3);text-transform:uppercase;letter-spacing:0.06em;margin-top:0.25rem;}
.dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:0.8rem;}
.dash-viz{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1rem 1.1rem;}
.dash-viz h5{font-family:var(--fd);font-size:0.86rem;font-weight:700;color:var(--ow9);margin-bottom:0.15rem;}
.dash-viz .v-sub{font-size:0.7rem;color:var(--ow3);margin-bottom:0.7rem;}
.dash-viz .v-wrap{position:relative;height:190px;}
.dash-active-note{font-size:0.72rem;color:var(--cyan);margin-bottom:0.8rem;font-weight:600;min-height:1em;}
/* ── HOW WE'D BUILD THIS (process roadmap) ── */
.roadmap{margin-top:1rem;}
.rm-intro{font-size:0.92rem;color:var(--ow7);line-height:1.7;margin-bottom:1.4rem;max-width:680px;}
.rm-intro b{color:var(--ow9);}
.rm-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:0.7rem;margin-bottom:1.4rem;}
.rm-step{background:var(--card);border:1px solid var(--bw);border-radius:var(--r);padding:1rem 0.9rem;position:relative;}
.rm-step .rm-num{width:26px;height:26px;border-radius:7px;background:var(--n8);color:var(--cyan);font-family:var(--fd);font-weight:800;font-size:0.8rem;display:flex;align-items:center;justify-content:center;margin-bottom:0.6rem;}
.rm-step h5{font-family:var(--fd);font-size:0.82rem;font-weight:700;color:var(--ow9);margin-bottom:0.3rem;line-height:1.25;}
.rm-step p{font-size:0.72rem;color:var(--ow5);line-height:1.5;}
.rm-meta{display:flex;gap:0.7rem;flex-wrap:wrap;margin-bottom:1.4rem;}
.rm-pill{display:inline-flex;align-items:center;gap:7px;background:var(--card);border:1px solid var(--bw);border-radius:999px;padding:0.5rem 1rem;font-size:0.8rem;color:var(--ow7);}
.rm-pill b{color:var(--ow9);font-weight:700;}
.rm-pill .rm-ic{color:var(--cyan);}
@media(max-width:760px){.rm-steps{grid-template-columns:1fr 1fr;}}

@media(max-width:760px){
  .dash{grid-template-columns:1fr;}
  .dash-filters{position:static;order:2;padding:0.5rem 0.9rem;}
  .dash-main{order:1;}
  .dash-filters-head{cursor:pointer;padding:0.5rem 0;}
  .dash-filters-head .fh-chev{display:inline;transition:transform 0.2s;}
  .dash-filters.open .fh-chev{transform:rotate(180deg);}
  .dash-filters-body{display:none;}
  .dash-filters.open .dash-filters-body{display:block;padding-top:0.4rem;}
  .dash-kpis{grid-template-columns:repeat(2,1fr);}
  .dash-grid{grid-template-columns:1fr;}
  .kpis{grid-template-columns:repeat(2,1fr);}
  .chart-grid{grid-template-columns:1fr;}
  .col-hdr,.col-row{grid-template-columns:1.4fr 0.8fr 0.6fr;}
  .col-spark-cell{display:none;}
}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-container">
    <a href="index.html" class="brand"><span class="bmark"><svg viewBox="0 0 256 256" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="nm13" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#00d4ff"/><stop offset="1" stop-color="#5b9dff"/></linearGradient></defs><g stroke="url(#nm13)" stroke-width="9" stroke-linecap="round" fill="none"><path d="M128 70 L186 104 L186 152 L128 186 L70 152 L70 104 Z"/><line x1="128" y1="70" x2="128" y2="128"/><line x1="186" y1="152" x2="128" y2="128"/><line x1="70" y1="152" x2="128" y2="128"/></g><g fill="#00d4ff"><circle cx="128" cy="70" r="11"/><circle cx="186" cy="104" r="9"/><circle cx="186" cy="152" r="9"/><circle cx="128" cy="186" r="11"/><circle cx="70" cy="152" r="9"/><circle cx="70" cy="104" r="9"/></g><circle cx="128" cy="128" r="14" fill="#aef0ff"/></svg></span>Datavoris</a>
    <div class="nav-links" id="navLinks">
      <a href="index.html#services">Services</a>
      <a href="index.html#tools">Tools</a>
      <a href="index.html#work">Work</a>
      <a href="dv-founder.html">About</a>
      <a href="blog.html">Blog</a>      <a href="dv-assessment.html">Assessment</a>
      <a href="dv-analyzer.html" class="active">Analyzer</a>
      <a href="index.html#contact">Contact</a>
      <div class="nav-cta-mobile"><a href="index.html#contact">Let's talk</a></div>
    </div>
    <button class="nav-burger" id="navBurger" aria-label="Menu" aria-expanded="false" onclick="(function(b){var l=document.getElementById('navLinks');var d=document.getElementById('navBackdrop');var o=!l.classList.contains('open');l.classList.toggle('open',o);b.classList.toggle('open',o);if(d)d.classList.toggle('open',o);b.setAttribute('aria-expanded',o?'true':'false');})(this)">
      <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
      <svg class="x-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <a href="index.html#contact" class="hire-btn">Let's talk</a>
  </div>
</nav>
<div class="nav-backdrop" id="navBackdrop" onclick="document.getElementById('navBurger').click()"></div>

<main class="main">
  <div class="fade" id="introBlock">
    <div class="page-eyebrow">Free Tool · Datavoris</div>
    <h1 class="page-title">See your data come to life — <em>instantly</em>.</h1>
    <p class="page-sub">Upload a small spreadsheet and get an automatic analysis — column types, data quality, distributions, correlations, and the first things worth fixing. This is a taste of what a real automated reporting system does for you every single day.</p>
    <div class="privacy">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      100% private — your file is processed in your browser and never uploaded anywhere.
    </div>
  </div>

  <div class="drop fade" id="drop">
    <div class="drop-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="#00d4ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
    </div>
    <div class="drop-title">Drop your dataset here</div>
    <div class="drop-sub">CSV or Excel · up to ~5,000 rows works best</div>
    <button class="drop-btn" type="button" id="pickBtn">Choose a file</button>
    <div class="drop-formats">.csv · .xlsx · .xls · .tsv</div>
    <div class="sample-link">No file handy? <a id="sampleBtn">Try it with sample sales data →</a></div>
    <input type="file" id="fileInput" accept=".csv,.tsv,.xlsx,.xls" style="display:none"/>
  </div>

  <div class="err" id="err"></div>

  <div class="results" id="results"></div>

  <!-- PROCESSING OVERLAY -->
  <div class="anz-proc" id="anzProc" role="status" aria-live="polite">
    <div class="anz-proc-inner">
      <span class="anz-brand-pill">Datavoris · Live analysis</span>
      <div class="anz-orb">
        <svg class="anz-ring outer" viewBox="0 0 140 140" aria-hidden="true"><defs><linearGradient id="anzGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" stop-color="#00d4ff"/><stop offset="100%" stop-color="#5b9dff"/></linearGradient></defs><circle class="anz-ring-bg" cx="70" cy="70" r="64"/><circle class="anz-ring-fg" id="anzRing" cx="70" cy="70" r="64"/></svg>
        <svg class="anz-ring inner" viewBox="0 0 140 140" aria-hidden="true"><circle class="anz-ring-orbit" cx="70" cy="70" r="48"/></svg>
        <div class="anz-pct"><span id="anzPct">0%</span><span class="pct-sub">Processing</span></div>
      </div>
      <div class="anz-head-wrap">
        <div class="anz-head" id="anzHead">Reading your data…</div>
        <p class="anz-sub" id="anzSub">Parsing the file structure and validating each row.</p>
      </div>
      <div class="anz-steps" id="anzSteps">
        <div class="anz-step" data-step="0"><span class="anz-tick"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg></span>Reading the file</div>
        <div class="anz-step" data-step="1"><span class="anz-tick"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg></span>Detecting column types</div>
        <div class="anz-step" data-step="2"><span class="anz-tick"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 14l4-4 4 4 6-6"/></svg></span>Computing statistics</div>
        <div class="anz-step" data-step="3"><span class="anz-tick"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg></span>Finding correlations &amp; patterns</div>
        <div class="anz-step" data-step="4"><span class="anz-tick"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></span>Rendering your charts</div>
      </div>
      <div class="anz-counters" id="anzCounters">
        <div class="anz-counter" data-counter="rows"><div class="anz-counter-n">—</div><div class="anz-counter-l">Rows</div></div>
        <div class="anz-counter" data-counter="cols"><div class="anz-counter-n">—</div><div class="anz-counter-l">Columns</div></div>
        <div class="anz-counter" data-counter="types"><div class="anz-counter-n">—</div><div class="anz-counter-l">Types found</div></div>
        <div class="anz-counter" data-counter="health"><div class="anz-counter-n">—</div><div class="anz-counter-l">Quality %</div></div>
      </div>
      <span class="anz-priv"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>Processing locally — nothing is uploaded</span>
    </div>
  </div>

</main>

<div class="footer" style="padding-bottom:2rem">datavoris.com · Instant Data Analyzer</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" integrity="sha512-dfX5uYVXzyU8+KHqj8bjo7UkOdg18PaOtpa48djpNbZHwExddghZ+ZmzWT06R5v6NSk3ZUfsH6FNEDepLx9hPQ==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js" integrity="sha512-r22gChDnGvBylk90+2e/ycr3RVrDi8DIOkIGNhJlKfuyQM4tIRAI062MaV8sfjQKYVGjOBaZBOA87z+IhZE9DA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js" integrity="sha512-CQBWl4fJHWbryGE+Pc7UAxWMUMNMWzWxF4SQo9CgkJIN1kx6djDQZjh3Y8SZ1d+6I+1zze6Z7kHXO7q3UyZAWw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
const $=id=>document.getElementById(id);
const drop=$('drop'),fileInput=$('fileInput'),results=$('results'),errBox=$('err');
let charts=[];

$('pickBtn').onclick=()=>fileInput.click();
drop.onclick=e=>{if(e.target.id!=='sampleBtn')fileInput.click();};
fileInput.onchange=e=>{if(e.target.files[0])handleFile(e.target.files[0]);};
['dragover','dragenter'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('drag');}));
['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('drag');}));
drop.addEventListener('drop',e=>{const f=e.dataTransfer.files[0];if(f)handleFile(f);});

$('sampleBtn').onclick=e=>{e.stopPropagation();loadSample();};

function showErr(m){errBox.textContent=m;errBox.style.display='block';}
function clearErr(){errBox.style.display='none';}

function handleFile(file){
  clearErr();
  const name=file.name.toLowerCase();
  if(file.size>15*1024*1024){showErr('That file is larger than 15MB. This tool is built for small datasets — try a sample or a smaller export.');return;}
  if(name.endsWith('.xlsx')||name.endsWith('.xls')){
    const r=new FileReader();
    r.onload=ev=>{
      try{
        const wb=XLSX.read(ev.target.result,{type:'array'});
        const ws=wb.Sheets[wb.SheetNames[0]];
        const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:null,blankrows:false});
        const headers=rows[0].map(h=>h==null?'':String(h));
        const data=rows.slice(1).map(r=>{const o={};headers.forEach((h,i)=>o[h]=r[i]);return o;});
        runAnzProc(headers,data,()=>analyze(headers,data,file.name));
      }catch(err){showErr('Could not read that Excel file. Try saving it as CSV and uploading again.');}
    };
    r.readAsArrayBuffer(file);
  }else{
    Papa.parse(file,{header:true,dynamicTyping:false,skipEmptyLines:true,
      complete:res=>{
        if(!res.data.length){showErr('That file looks empty.');return;}
        const _headers=res.meta.fields||Object.keys(res.data[0]);
        runAnzProc(_headers,res.data,()=>analyze(_headers,res.data,file.name));
      },
      error:()=>showErr('Could not parse that file.')});
  }
}

function loadSample(){
  clearErr();
  // Realistic B2B sales data with deliberate, discoverable patterns:
  // - upward growth trend across the year + Q4 seasonal bump
  // - West region outperforms; one rep (Priya) is a top performer
  // - Enterprise deals are larger but rarer; clear units↔revenue link
  // - a few missing CSAT values (realistic data-quality gap)
  const regions=['North','South','East','West'];
  const regionStrength={North:0.85,South:0.95,East:0.8,West:1.35}; // West strongest
  const reps=['Asha Rao','Vikram Singh','Maya Iyer','Devon Clarke','Priya Nair'];
  const repStrength={'Asha Rao':0.95,'Vikram Singh':0.85,'Maya Iyer':1.0,'Devon Clarke':0.8,'Priya Nair':1.4}; // Priya top
  const segments=['SMB','Mid-Market','Enterprise'];
  const segMix=[0.5,0.35,0.15]; // Enterprise rarer
  const products=['Analytics Suite','Automation Platform','Data Warehouse','Support Plan'];
  const headers=['Date','Region','Sales Rep','Segment','Product','Units','Deal Size','Discount %','Revenue','CSAT'];
  const data=[];

  function pickWeighted(arr,weights){
    const r=Math.random();let acc=0;
    for(let i=0;i<arr.length;i++){acc+=weights[i];if(r<=acc)return arr[i];}
    return arr[arr.length-1];
  }

  for(let i=0;i<220;i++){
    const month=Math.floor(Math.random()*12); // 0-11
    // growth trend: deals get bigger later in the year, plus a Q4 (Oct-Dec) bump
    const trend=1+(month/11)*0.5;
    const q4=(month>=9)?1.25:1;
    const region=regions[Math.floor(Math.random()*regions.length)];
    const rep=reps[Math.floor(Math.random()*reps.length)];
    const seg=pickWeighted(segments,segMix);
    const segMult=seg==='Enterprise'?3.2:seg==='Mid-Market'?1.6:1;
    const product=products[Math.floor(Math.random()*products.length)];

    const units=Math.max(1,Math.round((seg==='Enterprise'?8:seg==='Mid-Market'?4:2)+Math.random()*6*segMult));
    const dealSize=+( (400+Math.random()*600) * segMult ).toFixed(2); // price per unit
    const disc=Math.random()<0.35?+(Math.random()*22).toFixed(1):0;
    const baseRev=units*dealSize*(1-disc/100);
    const revenue=+(baseRev*trend*q4*regionStrength[region]*repStrength[rep]).toFixed(2);
    const d=new Date(2024,month,1+Math.floor(Math.random()*28));
    // CSAT: generally high, slightly lower when big discounts (haggled deals), ~6% missing
    const csat=Math.random()<0.06?null:+Math.min(5,Math.max(2.5,(4.4-(disc/100)*1.5+ (Math.random()*0.6-0.3)))).toFixed(1);

    data.push({
      'Date':d.toISOString().slice(0,10),
      'Region':region,
      'Sales Rep':rep,
      'Segment':seg,
      'Product':product,
      'Units':units,
      'Deal Size':dealSize,
      'Discount %':disc,
      'Revenue':revenue,
      'CSAT':csat
    });
  }
  runAnzProc(headers,data,()=>analyze(headers,data,'sample-sales-data.csv'));
}

// ---------- PROCESSING ANIMATION ----------
function _quickPeek(headers,data){
  const rowCount=data.length;
  const colCount=headers.length;
  const types=new Set();
  let totalCells=0,filledCells=0;
  headers.forEach(h=>{
    const vals=data.map(r=>r[h]);
    types.add(detectType(vals));
    vals.forEach(v=>{totalCells++;if(v!==null&&v!==undefined&&String(v).trim()!=='')filledCells++;});
  });
  types.delete('empty');
  const completeness=totalCells?Math.round(filledCells/totalCells*100):0;
  return{rowCount,colCount,typeCount:types.size,completeness};
}
function _setCounter(key,val,live){
  const card=document.querySelector('[data-counter="'+key+'"]');
  if(!card)return;
  const n=card.querySelector('.anz-counter-n');
  if(n){
    if(typeof val==='number'){
      const start=0,end=val,dur=550,t0=performance.now();
      function step(now){const k=Math.min(1,(now-t0)/dur);n.textContent=Math.round(start+(end-start)*k).toLocaleString()+(key==='health'?'%':'');if(k<1)requestAnimationFrame(step);}
      requestAnimationFrame(step);
    }else{
      n.textContent=val;
    }
  }
  if(live)card.classList.add('live');
}
function runAnzProc(headers,data,done){
  const overlay=$('anzProc'),ring=$('anzRing'),pctEl=$('anzPct'),headEl=$('anzHead'),subEl=$('anzSub');
  const steps=[...document.querySelectorAll('.anz-step')];
  const counters=[...document.querySelectorAll('.anz-counter')];
  steps.forEach(s=>s.classList.remove('active','done'));
  counters.forEach(c=>{c.classList.remove('live');const n=c.querySelector('.anz-counter-n');if(n)n.textContent='—';});
  const C=2*Math.PI*64;
  if(ring){ring.style.strokeDasharray=C;ring.style.strokeDashoffset=C;}
  window.scrollTo(0,0);overlay.classList.add('show');document.documentElement.style.overflow='hidden';
  // Compute the real stats up-front; reveal progressively during animation
  let peek=null;try{peek=_quickPeek(headers,data);}catch(e){peek={rowCount:data.length,colCount:headers.length,typeCount:0,completeness:0};}
  const heads=[
    'Reading your data…',
    'Understanding your columns…',
    'Crunching the numbers…',
    'Looking for patterns…',
    'Drawing your dashboard…'
  ];
  const subs=[
    'Parsing the file structure and validating each row.',
    'Inferring whether each column is numeric, categorical, a date, or free text.',
    'Calculating averages, ranges, frequencies, and data-quality scores.',
    'Detecting correlations, outliers, and meaningful relationships in your data.',
    'Picking the charts that best summarise what your data is telling you.'
  ];
  const targets=[20,44,64,84,100];
  const holds=[800,1100,1000,1100,800];
  let i=0,prog=0;
  function setProg(p){prog=p;if(ring)ring.style.strokeDashoffset=C*(1-p/100);if(pctEl)pctEl.textContent=Math.round(p)+'%';}
  function tick(){
    if(i>=steps.length){
      setTimeout(()=>{overlay.classList.remove('show');document.documentElement.style.overflow='';done();},700);
      return;
    }
    steps[i].classList.add('active');
    if(headEl)headEl.textContent=heads[i];
    if(subEl)subEl.textContent=subs[i];
    // reveal counters at the right step
    if(i===0)_setCounter('rows',peek.rowCount,true);
    if(i===1){_setCounter('cols',peek.colCount,true);_setCounter('types',peek.typeCount,true);}
    if(i===2)_setCounter('health',peek.completeness,true);
    const start=prog,end=targets[i],dur=holds[i],t0=performance.now();
    function anim(now){
      const k=Math.min(1,(now-t0)/dur);
      setProg(start+(end-start)*(k<0.5?2*k*k:1-Math.pow(-2*k+2,2)/2));
      if(k<1)requestAnimationFrame(anim);
      else{steps[i].classList.remove('active');steps[i].classList.add('done');i++;tick();}
    }
    requestAnimationFrame(anim);
  }
  setProg(0);
  setTimeout(tick,450);
}

// ---------- TYPE DETECTION ----------
function detectType(values){
  const non=values.filter(v=>v!==null&&v!==undefined&&String(v).trim()!=='');
  if(!non.length)return'empty';
  let numC=0,dateC=0;
  const dateRe=/^\d{4}[-/]\d{1,2}[-/]\d{1,2}|^\d{1,2}[-/]\d{1,2}[-/]\d{2,4}/;
  for(const v of non){
    const s=String(v).trim().replace(/[$,%₹€£\s]/g,'');
    if(s!==''&&!isNaN(s)&&isFinite(s))numC++;
    if(dateRe.test(String(v).trim())&&!isNaN(Date.parse(v)))dateC++;
  }
  if(dateC/non.length>0.7)return'date';
  if(numC/non.length>0.85)return'number';
  const uniq=new Set(non.map(v=>String(v))).size;
  if(uniq<=Math.max(12,non.length*0.25))return'categorical';
  return'text';
}
function toNum(v){if(v===null||v===undefined)return NaN;return parseFloat(String(v).replace(/[$,%₹€£\s]/g,''));}

// ---------- STATS ----------
function numStats(vals){
  const n=vals.filter(v=>!isNaN(v)).sort((a,b)=>a-b);
  if(!n.length)return null;
  const sum=n.reduce((a,b)=>a+b,0),mean=sum/n.length;
  const med=n.length%2?n[(n.length-1)/2]:(n[n.length/2-1]+n[n.length/2])/2;
  const variance=n.reduce((a,b)=>a+(b-mean)**2,0)/n.length;
  return{min:n[0],max:n[n.length-1],mean,median:med,std:Math.sqrt(variance),count:n.length,
    q1:n[Math.floor(n.length*0.25)],q3:n[Math.floor(n.length*0.75)]};
}
function histogram(vals,bins=10){
  const n=vals.filter(v=>!isNaN(v));if(!n.length)return[];
  const mn=Math.min(...n),mx=Math.max(...n),range=mx-mn||1,w=range/bins;
  const h=new Array(bins).fill(0);
  n.forEach(v=>{let idx=Math.floor((v-mn)/w);if(idx>=bins)idx=bins-1;if(idx<0)idx=0;h[idx]++;});
  return h.map((c,i)=>({label:(mn+i*w).toFixed(mn%1||w<1?1:0),count:c}));
}
function freq(vals,top=8){
  const m={};vals.forEach(v=>{const k=(v===null||v===undefined||String(v).trim()==='')?'(blank)':String(v);m[k]=(m[k]||0)+1;});
  return Object.entries(m).sort((a,b)=>b[1]-a[1]).slice(0,top);
}
function pearson(a,b){
  const pairs=[];for(let i=0;i<a.length;i++){if(!isNaN(a[i])&&!isNaN(b[i]))pairs.push([a[i],b[i]]);}
  if(pairs.length<3)return null;
  const n=pairs.length,sx=pairs.reduce((s,p)=>s+p[0],0),sy=pairs.reduce((s,p)=>s+p[1],0);
  const mx=sx/n,my=sy/n;let num=0,dx=0,dy=0;
  pairs.forEach(p=>{num+=(p[0]-mx)*(p[1]-my);dx+=(p[0]-mx)**2;dy+=(p[1]-my)**2;});
  if(dx===0||dy===0)return null;
  return num/Math.sqrt(dx*dy);
}

// ---------- MAIN ANALYZE ----------
/**
 * Phase 0 architecture (spec-driven Analyzer):
 *   raw file → buildProfile() → Profile
 *   Profile + data → rulesGenerator() → ReportSpec
 *   ReportSpec + Profile + data → renderer (analyze + renderDashboard)
 *
 * Profile is what we *know* about the dataset (deterministic, no decisions).
 * ReportSpec is what we *render* (every decision lives here, one source of truth).
 * Phase 1 will replace rulesGenerator() with a Claude generator that produces the same
 * ReportSpec shape but with semantic column understanding. The renderer never changes.
 */
function buildProfile(headers, data){
  headers = headers.filter(h => h !== '');
  const rowCount = data.length;
  const cols = headers.map(h => {
    const values = data.map(r => r[h]);
    const type = detectType(values);
    const missing = values.filter(v => v===null||v===undefined||String(v).trim()==='').length;
    const uniq = new Set(values.filter(v=>v!==null&&v!==undefined&&String(v).trim()!=='').map(v=>String(v))).size;
    let stats=null, nums=null;
    if (type === 'number') { nums = values.map(toNum); stats = numStats(nums); }
    return { name:h, type, missing, missingPct: rowCount?missing/rowCount*100:0, uniq, values, nums, stats };
  });
  const numCols = cols.filter(c => c.type === 'number');
  const catCols = cols.filter(c => c.type === 'categorical');
  const dateCol = cols.find(c => c.type === 'date') || null;
  const totalCells = rowCount * cols.length;
  const totalMissing = cols.reduce((s,c) => s + c.missing, 0);
  const completeness = totalCells ? (1 - totalMissing/totalCells) * 100 : 100;
  const seen = new Set(); let dupes = 0;
  data.forEach(r => { const k = headers.map(h => r[h]).join('|'); if (seen.has(k)) dupes++; else seen.add(k); });
  let health = completeness * 0.7;
  health += (dupes === 0 ? 15 : dupes/rowCount < 0.05 ? 8 : 0);
  health += (cols.some(c => c.type === 'date') ? 8 : 4);
  health += (numCols.length >= 1 ? 7 : 0);
  health = Math.max(8, Math.min(99, Math.round(health)));
  return { rowCount, colCount: cols.length, headers, cols, numCols, catCols, dateCol, totalMissing, completeness, dupes, health };
}

/**
 * ReportSpec — declarative description of everything to render.
 *   source: string                          // filename
 *   meta: { rowCount, colCount, completeness, dupes, health, totalMissing }
 *   title: string                            // short page subtitle
 *   executiveSummary: string                 // HTML
 *   headlines: [{ sev:'critical'|'warn'|'good', tag, text }]
 *   outliers:  [{ col:{name}, row, value, delta, direction:'hi'|'lo' }]
 *   automationValue: { weeklyHours, annualHours, annualCost }
 *   insights:  [{ t:'good'|'warn'|'info', ic, x }]
 *   columnTable: [{ name, type, missing, missingPct, uniq, stats? }]
 *   charts:    [{ kind:'hist'|'bar'|'line'|'group', colName?, catName?, dateName?, valName?, title, sub }]
 *   correlation: { colNames:[...] } | null
 *   preview:   { columns:[name,...], rows:[[v,...],...] }
 *   dashboard: { metricColName, dateColName, filterColNames:[...], visuals:[{kind:'trend'|'byCat'|'dist'|'count', catName?, title, sub}] }
 */
function rulesGenerator(profile, data, fname){
  const { rowCount, cols, numCols, catCols, dateCol, completeness, dupes, health, totalMissing, headers } = profile;

  // ── Visual breakdown charts (detailed section): matches today's chartDefs heuristics ──
  const charts = [];
  if (numCols.length) {
    const c = numCols.map(x => ({ c:x, spread: x.stats ? x.stats.std/(Math.abs(x.stats.mean)||1) : 0 }))
      .sort((a,b) => b.spread - a.spread)[0].c;
    charts.push({ kind:'hist', colName:c.name, title:`Distribution of ${c.name}`, sub:'How values are spread' });
  }
  if (catCols.length) {
    const c = catCols.slice().sort((a,b) => a.uniq - b.uniq)[0];
    charts.push({ kind:'bar', colName:c.name, title:`${c.name} breakdown`, sub:'Count by category' });
  }
  if (dateCol && numCols.length) {
    const v = numCols[0];
    charts.push({ kind:'line', dateName:dateCol.name, valName:v.name, title:`${v.name} over time`, sub:'Trend by date' });
  }
  if (catCols.length && numCols.length) {
    const c = catCols.slice().sort((a,b) => a.uniq - b.uniq)[0];
    const v = numCols[0];
    charts.push({ kind:'group', catName:c.name, valName:v.name, title:`${v.name} by ${c.name}`, sub:'Totals per group' });
  }

  // ── Interactive dashboard: matches today's DASH setup + renderDashboard viz picker ──
  const metricCol = numCols.slice()
    .sort((a,b) => Math.abs(b.stats ? b.stats.mean : 0) - Math.abs(a.stats ? a.stats.mean : 0))[0] || null;
  const filterColNames = catCols.slice().sort((a,b) => a.uniq - b.uniq).filter(c => c.uniq <= 12).slice(0,4).map(c => c.name);

  const visuals = [];
  if (dateCol && metricCol) {
    visuals.push({ kind:'trend', title:`${short(metricCol.name)} over time`, sub:'Monthly trend' });
  }
  if (catCols.length && metricCol) {
    const c = catCols.slice().sort((a,b) => a.uniq - b.uniq)[0];
    visuals.push({ kind:'byCat', catName:c.name, title:`${short(metricCol.name)} by ${short(c.name)}`, sub:'Totals per group' });
  }
  if (catCols.length > 1 && metricCol) {
    const c = catCols.slice().sort((a,b) => a.uniq - b.uniq)[1];
    visuals.push({ kind:'byCat', catName:c.name, title:`${short(metricCol.name)} by ${short(c.name)}`, sub:'Totals per group' });
  }
  if (metricCol) {
    visuals.push({ kind:'dist', title:`${short(metricCol.name)} distribution`, sub:'How values spread' });
  }
  while (visuals.length < 4 && catCols.length >= (visuals.filter(v => v.kind === 'count').length + 1)) {
    const used = visuals.filter(v => v.catName).map(v => v.catName);
    const next = catCols.find(c => !used.includes(c.name));
    if (!next) break;
    visuals.push({ kind:'count', catName:next.name, title:`${short(next.name)} breakdown`, sub:'Record count' });
  }

  return {
    source: fname,
    meta: { rowCount, colCount: cols.length, completeness, dupes, health, totalMissing },
    title: `${rowCount.toLocaleString()} rows · ${cols.length} columns`,
    executiveSummary: execSummary(cols, numCols, catCols, dateCol, rowCount, completeness, dupes, health, fname),
    headlines: buildHeadlines(cols, numCols, catCols, dupes, rowCount, completeness, health),
    outliers: detectOutliers(numCols, data, headers),
    automationValue: estimateAutomationValue(rowCount, cols, numCols, health, dupes),
    insights: buildInsights(cols, numCols, catCols, dupes, rowCount, completeness),
    columnTable: cols.map(c => ({ name:c.name, type:c.type, missing:c.missing, missingPct:c.missingPct, uniq:c.uniq, stats:c.stats })),
    charts,
    correlation: numCols.length >= 2 ? { colNames: numCols.slice(0,6).map(c => c.name) } : null,
    preview: {
      columns: cols.map(c => c.name),
      rows: data.slice(0,8).map(r => cols.map(c => r[c.name]))
    },
    dashboard: {
      metricColName: metricCol ? metricCol.name : null,
      dateColName: dateCol ? dateCol.name : null,
      filterColNames,
      visuals
    }
  };
}

function analyze(headers, data, fname){
  clearErr();
  charts.forEach(c => { try { c.destroy(); } catch(e){} }); charts = [];

  // Phase 0: deterministic spec. Phase 1+ will source spec from Claude with rules fallback.
  const profile = buildProfile(headers, data);
  const spec = rulesGenerator(profile, data, fname);

  // Render-time aliases (no decisions are made below this line — everything reads from spec/profile)
  const { cols, numCols, catCols, dateCol, totalMissing } = profile;
  const { rowCount, completeness, dupes, health } = spec.meta;

  const headlinesHTML = spec.headlines.length
    ? `<div class="sec-label">Headline findings</div><div class="headlines">` +
      spec.headlines.map(h => `<div class="headline ${h.sev}"><span class="headline-tag">${esc(h.tag)}</span><div class="headline-text">${h.text}</div></div>`).join('') +
      `</div>`
    : '';

  let html = `
  <div class="file-bar fade">
    <div class="file-bar-left">
      <div class="file-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg></div>
      <div style="min-width:0"><div class="file-nm">${esc(spec.source)}</div>
      <div class="file-meta">${spec.title}</div></div>
    </div>
    <button class="file-reset" onclick="resetTool()">↺ Analyze another file</button>
  </div>

  ${headlinesHTML}

  <div class="exec-summary">
    <div class="es-tag"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="3" width="12" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>Executive Summary</div>
    <p>${spec.executiveSummary}</p>
  </div>

  <div class="sec-label">Interactive dashboard</div>
  <div class="dash">
    <aside class="dash-filters" id="dashFilters">
      <button class="dash-filters-head" type="button" onclick="toggleFilters()" aria-expanded="false">
        <span><span class="fh-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 6h13M3 12h7M3 18h11"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="16" cy="18" r="2"/></svg></span> Filters</span>
        <span class="fh-chev" id="fhChev">▾</span>
      </button>
      <div class="dash-filters-body" id="dashFiltersBody">
        <div class="fsub">Tap a value to slice the report</div>
        <div id="filterBody"></div>
        <button class="filter-reset" onclick="clearFilters()">Reset all filters</button>
      </div>
    </aside>
    <div class="dash-main">
      <div class="dash-active-note" id="activeNote"></div>
      <div class="dash-kpis" id="dashKpis"></div>
      <div class="dash-grid" id="dashGrid"></div>
    </div>
  </div>

  <div class="sec-label">Overview</div>
  <div class="kpis">
    <div class="kpi"><div class="kpi-n">${rowCount.toLocaleString()}</div><div class="kpi-l">Rows</div></div>
    <div class="kpi"><div class="kpi-n">${cols.length}</div><div class="kpi-l">Columns</div></div>
    <div class="kpi"><div class="kpi-n">${numCols.length}</div><div class="kpi-l">Numeric fields</div></div>
    <div class="kpi"><div class="kpi-n">${completeness.toFixed(0)}%</div><div class="kpi-l">Complete</div></div>
  </div>

  <div class="sec-label">Data health</div>
  <div class="health">
    <div class="health-ring" style="--p:${health}"><span>${health}</span></div>
    <div class="health-txt"><h3>${health>=80?'Strong — ready to automate':health>=55?'Workable — a few fixes needed':'Needs cleanup first'}</h3>
    <p>${healthMsg(health,totalMissing,dupes,rowCount,cols)}</p></div>
  </div>`;

  // OUTLIERS card — driven by spec.outliers
  if (spec.outliers.length) {
    html += `<div class="sec-label">Outliers worth a look</div>
    <div class="outliers">
      <div class="outliers-head">
        <div>
          <div class="outliers-title">Values that stand out from the rest</div>
          <p class="outliers-sub">These data points sit well outside the normal range for their column. Sometimes that's a real signal (a record sale, a top customer). Sometimes it's a data-entry error worth catching before it skews a report.</p>
        </div>
        <span class="outliers-pill">${spec.outliers.length} flagged</span>
      </div>
      <div class="outliers-list">`;
    spec.outliers.forEach(o => {
      const cls = o.delta > 4 ? 'hi' : '';
      const direction = o.direction === 'hi' ? 'above' : 'below';
      html += `<div class="outlier-row"><div class="outlier-col">${esc(o.col.name)}<div class="ot-meta">Row ${o.row+2} · ${direction} the typical range</div></div><div class="outlier-val">${fmt(o.value)}</div><div class="outlier-delta ${cls}">${o.delta.toFixed(1)}σ from median</div></div>`;
    });
    html += `</div></div>`;
  }

  // AUTOMATION VALUE callout — driven by spec.automationValue
  const av = spec.automationValue;
  const fmt$ = n => '$' + n.toLocaleString();
  html += `<div class="sec-label">If this report ran itself</div>
  <div class="autoval">
    <span class="autoval-tag">Estimated automation value</span>
    <h3>This dataset could be powering an automated report — instead of a weekly spreadsheet ritual.</h3>
    <div class="autoval-figure">~${av.weeklyHours} hrs<sub> / week saved</sub></div>
    <p class="autoval-body">Based on the size, complexity, and current state of your data, manually producing this kind of report typically eats <b>~${av.weeklyHours} hours per week</b>. Over a year that's <b>~${av.annualHours.toLocaleString()} hours</b> — roughly <b>${fmt$(av.annualCost)}</b> in team time at a $45/hr blended rate. Automating it once means it just keeps running.</p>
    <div class="autoval-pills">
      <span class="autoval-pill"><b>${rowCount.toLocaleString()}</b> rows handled automatically</span>
      <span class="autoval-pill"><b>${cols.length}</b> columns kept in sync</span>
      <span class="autoval-pill">Health score <b>${health}/100</b></span>
    </div>
    <a class="autoval-cta" href="index.html#contact">Talk to me about automating this →</a>
    <p class="autoval-note">Rough heuristic, based on dataset size, column count, and data-quality score. Real figures depend on how the report is currently being produced — tends to under-estimate complex reports stitched from multiple sources.</p>
  </div>`;

  // INSIGHTS — driven by spec.insights
  html += `<div class="sec-label">Key findings</div><div class="insight-list">`;
  spec.insights.forEach(i => html += `<div class="insight ${i.t}"><span class="insight-ic">${i.ic}</span><div class="insight-tx">${i.x}</div></div>`);
  html += `</div>`;

  // COLUMN PROFILE — uses profile.cols (sparklines need raw values/nums)
  html += `<div class="sec-label">Column profile</div><div class="col-table">
    <div class="col-hdr"><div>Column</div><div>Type</div><div>Missing</div><div class="col-spark-cell">Distribution</div></div>`;
  cols.forEach(c => {
    const tp = {number:['type-num','Number'], categorical:['type-cat','Category'], date:['type-date','Date'], text:['type-txt','Text'], empty:['type-txt','Empty']}[c.type];
    const mc = c.missingPct === 0 ? 'miss-ok' : c.missingPct < 10 ? 'miss-warn' : 'miss-bad';
    let spark = '', stat = '';
    if (c.type === 'number' && c.stats) {
      const h = histogram(c.nums, 12), mxc = Math.max(...h.map(b => b.count)) || 1;
      spark = '<div class="spark">' + h.map(b => `<i style="height:${b.count/mxc*100}%"></i>`).join('') + '</div>';
      stat = `<div class="col-stat">avg ${fmt(c.stats.mean)} · range ${fmt(c.stats.min)}–${fmt(c.stats.max)}</div>`;
    } else {
      const f = freq(c.values, 5), mxc = Math.max(...f.map(x => x[1])) || 1;
      spark = '<div class="spark">' + f.map(x => `<i style="height:${x[1]/mxc*100}%"></i>`).join('') + '</div>';
      stat = `<div class="col-stat">${c.uniq} unique${f.length?` · top: ${esc(f[0][0])}`:''}</div>`;
    }
    html += `<div class="col-row"><div class="col-nm" title="${esc(c.name)}">${esc(c.name)}</div>
      <div><span class="type-pill ${tp[0]}">${tp[1]}</span></div>
      <div class="col-miss ${mc}">${c.missing===0?'None':c.missingPct.toFixed(0)+'%'}</div>
      <div class="col-spark-cell">${spark}${stat}</div></div>`;
  });
  html += `</div>`;

  // VISUAL BREAKDOWN — driven by spec.charts
  if (spec.charts.length) {
    html += `<div class="sec-label">Visual breakdown</div><div class="chart-grid">`;
    spec.charts.slice(0,4).forEach((d,i) => {
      html += `<div class="chart-card"><h4>${esc(d.title)}</h4><div class="ch-sub">${esc(d.sub)}</div><div class="chart-wrap"><canvas id="ch${i}"></canvas></div></div>`;
    });
    html += `</div>`;
  }

  // CORRELATION — driven by spec.correlation (matrix re-computed in renderer because it needs nums arrays)
  let corrHTML = '';
  if (spec.correlation) {
    const nc = spec.correlation.colNames.map(n => cols.find(c => c.name === n));
    corrHTML = `<div class="sec-label">Correlations</div><div class="corr-wrap"><div class="corr-grid" style="grid-template-columns:90px repeat(${nc.length},46px)">`;
    corrHTML += `<div></div>` + nc.map(c => `<div class="corr-lbl v">${esc(short(c.name))}</div>`).join('');
    nc.forEach(rc => {
      corrHTML += `<div class="corr-lbl" style="justify-content:flex-end;text-align:right">${esc(short(rc.name))}</div>`;
      nc.forEach(cc => {
        const r = rc === cc ? 1 : pearson(rc.nums, cc.nums);
        const v = r === null ? null : r;
        const bg = v === null ? '#eef2fa' : corrColor(v);
        const txt = v === null ? '–' : v.toFixed(1);
        const tc = v !== null && Math.abs(v) > 0.5 ? '#fff' : '#1a2744';
        corrHTML += `<div class="corr-cell" style="background:${bg};color:${tc}" title="${esc(rc.name)} vs ${esc(cc.name)}: ${v===null?'n/a':v.toFixed(2)}">${txt}</div>`;
      });
    });
    corrHTML += `</div></div>`;
  }
  html += corrHTML;

  // PREVIEW — driven by spec.preview
  html += `<div class="sec-label">Data preview · first 8 rows</div><div class="prev-wrap"><table class="prev"><thead><tr>` +
    spec.preview.columns.map(n => `<th>${esc(n)}</th>`).join('') + `</tr></thead><tbody>` +
    spec.preview.rows.map(row => `<tr>` + row.map(v => `<td>${esc(fmtCell(v))}</td>`).join('') + `</tr>`).join('') +
    `</tbody></table></div>`;

  // ROADMAP — static (not part of spec yet)
  html += `<div class="sec-label">How we'd turn this into a live system</div>
  <div class="roadmap">
    <p class="rm-intro">What you're looking at is a one-off snapshot. The real value is when it runs <b>automatically</b> — refreshing on its own, flagging issues, and landing in your inbox or a live dashboard. Here's exactly how I'd take <b>your ${rowCount.toLocaleString()} rows across ${cols.length} columns</b> from this preview to a system that runs itself.</p>
    <div class="rm-steps">
      <div class="rm-step"><div class="rm-num">1</div><h5>Discovery call</h5><p>We talk through your data, your goal, and where the manual pain is. Free, ~30 min.</p></div>
      <div class="rm-step"><div class="rm-num">2</div><h5>Scope &amp; quote</h5><p>You get a clear, fixed proposal — exact deliverables, timeline, and price. No surprises.</p></div>
      <div class="rm-step"><div class="rm-num">3</div><h5>Build &amp; automate</h5><p>I build the pipeline, dashboards, and automations that turn this into a living system.</p></div>
      <div class="rm-step"><div class="rm-num">4</div><h5>Test &amp; launch</h5><p>We validate everything end-to-end, deploy it, and I hand it over with a walkthrough.</p></div>
      <div class="rm-step"><div class="rm-num">5</div><h5>Support</h5><p>It keeps running quietly in the background — and I'm there if anything needs a tweak.</p></div>
    </div>
    <div class="rm-meta">
      <span class="rm-pill"><span class="rm-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><b>Typically live in 1–2 weeks</b>, depending on scope</span>
      <span class="rm-pill"><span class="rm-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9l-4 4z"/></svg></span>Pricing is <b>tailored to your project</b> — quoted upfront, fixed</span>
      <span class="rm-pill"><span class="rm-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>Your data stays yours, handled securely</span>
    </div>
  </div>`;

  // CTA — static
  html += `<div class="cta">
    <h2>Want this running on your real data?</h2>
    <p>Book a free discovery call and I'll show you exactly what it would take to turn your data into an automated system — with a clear quote, no obligation.</p>
    <div class="cta-actions">
      <a href="index.html#contact" class="btn-cy">Book a free discovery call →</a>
      <a href="dv-assessment.html" class="btn-ol">Take the data maturity assessment</a>
    </div>
  </div>`;

  results.innerHTML = html;
  results.style.display = 'block';
  $('introBlock').style.display = 'none';
  drop.style.display = 'none';
  window.scrollTo({ top:0, behavior:'smooth' });

  // ── DASHBOARD STATE — driven by spec.dashboard ──
  DASH.headers = headers; DASH.data = data; DASH.cols = cols;
  DASH.numCols = numCols; DASH.catCols = catCols;
  DASH.dateCol = spec.dashboard.dateColName ? cols.find(c => c.name === spec.dashboard.dateColName) : null;
  DASH.health = health; DASH.completeness = completeness;
  DASH.metric = spec.dashboard.metricColName ? cols.find(c => c.name === spec.dashboard.metricColName) : null;
  DASH.filterCols = spec.dashboard.filterColNames.map(n => cols.find(c => c.name === n)).filter(Boolean);
  DASH.visuals = spec.dashboard.visuals;
  DASH.filters = {};
  buildFilterPanel();
  renderDashboard();

  // ── DETAIL CHARTS — driven by spec.charts ──
  requestAnimationFrame(() => {
    Chart.defaults.font.family = "'Inter',sans-serif";
    spec.charts.slice(0,4).forEach((d,i) => {
      const cv = $('ch' + i); if (!cv) return;
      const ctx = cv.getContext('2d');
      if (d.kind === 'hist') {
        const c = cols.find(x => x.name === d.colName);
        const h = histogram(c.nums, 12);
        charts.push(new Chart(ctx, { type:'bar', data:{labels:h.map(b=>b.label), datasets:[{data:h.map(b=>b.count), backgroundColor:'#00d4ff', borderRadius:4}]}, options: baseOpt() }));
      } else if (d.kind === 'bar') {
        const c = cols.find(x => x.name === d.colName);
        const f = freq(c.values, 8);
        charts.push(new Chart(ctx, { type:'bar', data:{labels:f.map(x=>x[0]), datasets:[{data:f.map(x=>x[1]), backgroundColor:'#5b9dff', borderRadius:4}]}, options: {...baseOpt(), indexAxis:'y'} }));
      } else if (d.kind === 'line') {
        const agg = {};
        data.forEach(r => { const k = String(r[d.dateName]).slice(0,7); const v = toNum(r[d.valName]); if (!isNaN(v) && k.length >= 7) agg[k] = (agg[k] || 0) + v; });
        const keys = Object.keys(agg).sort();
        charts.push(new Chart(ctx, { type:'line', data:{labels:keys, datasets:[{data:keys.map(k=>agg[k]), borderColor:'#00d4ff', backgroundColor:'rgba(0,212,255,0.1)', fill:true, tension:0.3, pointRadius:3, pointBackgroundColor:'#00d4ff'}]}, options: baseOpt() }));
      } else if (d.kind === 'group') {
        const agg = {};
        data.forEach(r => { const k = String(r[d.catName] == null ? '(blank)' : r[d.catName]); const v = toNum(r[d.valName]); if (!isNaN(v)) agg[k] = (agg[k] || 0) + v; });
        const ent = Object.entries(agg).sort((a,b) => b[1] - a[1]).slice(0,8);
        charts.push(new Chart(ctx, { type:'bar', data:{labels:ent.map(e=>e[0]), datasets:[{data:ent.map(e=>e[1]), backgroundColor:'#10d9a0', borderRadius:4}]}, options: baseOpt() }));
      }
    });
  });
}

const DASH={};
let dashCharts=[];

function getFilteredRows(){
  const f=DASH.filters||{};
  const active=Object.keys(f).filter(k=>f[k]&&f[k].size>0);
  if(!active.length)return DASH.data;
  return DASH.data.filter(r=>active.every(col=>f[col].has(String(r[col]==null?'':r[col]))));
}

function buildFilterPanel(){
  const body=$('filterBody');
  if(!DASH.filterCols.length){body.innerHTML='<div style="font-size:0.76rem;color:var(--ow3);line-height:1.5">No categorical columns available to filter on.</div>';return;}
  let h='';
  DASH.filterCols.forEach(c=>{
    const f=freq(c.values,12);
    h+=`<div class="filter-group"><div class="fg-label">${esc(c.name)}</div>`;
    f.forEach(([val,cnt])=>{
      const id='flt_'+Math.random().toString(36).slice(2,8);
      h+=`<label class="filter-opt"><input type="checkbox" data-col="${esc(c.name)}" data-val="${esc(val)}" onchange="onFilterChange(this)"><span>${esc(val)}</span><span class="cnt">${cnt}</span></label>`;
    });
    h+=`</div>`;
  });
  body.innerHTML=h;
}

function onFilterChange(el){
  const col=el.getAttribute('data-col'), val=el.getAttribute('data-val');
  if(!DASH.filters[col])DASH.filters[col]=new Set();
  if(el.checked)DASH.filters[col].add(val); else DASH.filters[col].delete(val);
  renderDashboard();
}

function clearFilters(){
  DASH.filters={};
  document.querySelectorAll('#filterBody input[type=checkbox]').forEach(c=>c.checked=false);
  renderDashboard();
}

function toggleFilters(){
  const el=document.getElementById('dashFilters');
  if(!el)return;
  const head=el.querySelector('.dash-filters-head');
  const open=el.classList.toggle('open');
  if(head)head.setAttribute('aria-expanded',open?'true':'false');
}

function renderDashboard(){
  const rows = getFilteredRows();
  const total = DASH.data.length;
  const f = DASH.filters || {};
  const activeBits = Object.keys(f).filter(k => f[k] && f[k].size).map(k => `${k}: ${[...f[k]].join(', ')}`);
  $('activeNote').textContent = activeBits.length
    ? `Filtered → ${activeBits.join('  ·  ')}  (${rows.length.toLocaleString()} of ${total.toLocaleString()} rows)`
    : '';

  // KPIs — same shape as before (decisions live in spec; renderer just renders)
  const m = DASH.metric;
  let kpis = '';
  if (m) {
    const vals = rows.map(r => toNum(r[m.name])).filter(v => !isNaN(v));
    const sum = vals.reduce((a,b) => a + b, 0), avg = vals.length ? sum/vals.length : 0;
    kpis += `<div class="dash-kpi"><div class="k-n">${fmt(sum)}</div><div class="k-l">Total ${esc(short(m.name))}</div></div>`;
    kpis += `<div class="dash-kpi"><div class="k-n">${fmt(avg)}</div><div class="k-l">Avg ${esc(short(m.name))}</div></div>`;
  } else {
    kpis += `<div class="dash-kpi"><div class="k-n">${rows.length.toLocaleString()}</div><div class="k-l">Rows</div></div>`;
    kpis += `<div class="dash-kpi"><div class="k-n">${DASH.cols.length}</div><div class="k-l">Columns</div></div>`;
  }
  kpis += `<div class="dash-kpi"><div class="k-n">${rows.length.toLocaleString()}</div><div class="k-l">Records</div></div>`;
  kpis += `<div class="dash-kpi"><div class="k-n">${DASH.health}</div><div class="k-l">Health score</div></div>`;
  $('dashKpis').innerHTML = kpis;

  // VISUALS — driven by DASH.visuals (chosen once by rulesGenerator at analyze-time)
  const grid = $('dashGrid');
  const viz = (DASH.visuals || []).slice(0,4).map((v,i) => ({ ...v, id: 'dv' + i }));

  grid.innerHTML = viz.length
    ? viz.map(v => `<div class="dash-viz"><h5>${esc(v.title)}</h5><div class="v-sub">${v.sub}</div><div class="v-wrap"><canvas id="${v.id}"></canvas></div></div>`).join('')
    : '<div class="dash-viz"><h5>Not enough structured data</h5><div class="v-sub">Upload data with numbers, categories, or dates to see charts.</div></div>';

  dashCharts.forEach(c => { try { c.destroy(); } catch(e){} });
  dashCharts = [];
  requestAnimationFrame(() => {
    viz.forEach(v => {
      const cv = $(v.id); if (!cv) return;
      const ctx = cv.getContext('2d');
      if (v.kind === 'trend') {
        const agg = {};
        rows.forEach(r => { const k = String(r[DASH.dateCol.name]).slice(0,7); const val = toNum(r[m.name]); if (!isNaN(val) && k.length >= 7) agg[k] = (agg[k] || 0) + val; });
        const keys = Object.keys(agg).sort();
        dashCharts.push(new Chart(ctx, { type:'line', data:{labels:keys, datasets:[{data:keys.map(k=>agg[k]), borderColor:'#00d4ff', backgroundColor:'rgba(0,212,255,0.12)', fill:true, tension:0.3, pointRadius:2, pointBackgroundColor:'#00d4ff'}]}, options: baseOpt() }));
      } else if (v.kind === 'byCat') {
        const agg = {};
        rows.forEach(r => { const k = String(r[v.catName] == null ? '(blank)' : r[v.catName]); const val = toNum(r[m.name]); if (!isNaN(val)) agg[k] = (agg[k] || 0) + val; });
        const ent = Object.entries(agg).sort((a,b) => b[1] - a[1]).slice(0,8);
        dashCharts.push(new Chart(ctx, { type:'bar', data:{labels:ent.map(e=>e[0]), datasets:[{data:ent.map(e=>e[1]), backgroundColor:'#5b9dff', borderRadius:4}]}, options: {...baseOpt(), indexAxis:'y'} }));
      } else if (v.kind === 'dist') {
        const nums = rows.map(r => toNum(r[m.name])).filter(x => !isNaN(x));
        const h = histogram(nums, 10);
        dashCharts.push(new Chart(ctx, { type:'bar', data:{labels:h.map(b=>b.label), datasets:[{data:h.map(b=>b.count), backgroundColor:'#10d9a0', borderRadius:4}]}, options: baseOpt() }));
      } else if (v.kind === 'count') {
        const agg = {};
        rows.forEach(r => { const k = String(r[v.catName] == null ? '(blank)' : r[v.catName]); agg[k] = (agg[k] || 0) + 1; });
        const ent = Object.entries(agg).sort((a,b) => b[1] - a[1]).slice(0,8);
        dashCharts.push(new Chart(ctx, { type:'bar', data:{labels:ent.map(e=>e[0]), datasets:[{data:ent.map(e=>e[1]), backgroundColor:'#f59e0b', borderRadius:4}]}, options: baseOpt() }));
      }
    });
  });
}

function baseOpt(){return{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false},tooltip:{backgroundColor:'#0a1628',padding:9,cornerRadius:7}},scales:{x:{grid:{display:false},ticks:{color:'#7a90b8',font:{size:10},maxRotation:45}},y:{grid:{color:'rgba(8,14,30,0.06)'},ticks:{color:'#7a90b8',font:{size:10}}}}};}

function dateCol0(cols){return cols.find(c=>c.type==='date')||null;}

// ---------- HEADLINES (priority findings) ----------
function buildHeadlines(cols,numCols,catCols,dupes,rowCount,completeness,health){
  const out=[];
  // CRITICAL: column missing > 30%
  const worstMissing=cols.filter(c=>c.missingPct>=30).sort((a,b)=>b.missingPct-a.missingPct)[0];
  if(worstMissing){
    out.push({sev:'critical',tag:'Data integrity',text:`Column <b>${esc(worstMissing.name)}</b> is missing <b>${worstMissing.missingPct.toFixed(0)}%</b> of values. Any total, average or trend based on it is currently unreliable.`});
  }
  // CRITICAL: duplicates
  if(dupes/rowCount>=0.05){
    out.push({sev:'critical',tag:'Duplicates',text:`<b>${dupes.toLocaleString()} duplicate rows</b> (${(dupes/rowCount*100).toFixed(0)}%) are inflating your numbers. Dedupe before reporting on this.`});
  }
  // WARN: dominant category
  const dominant=catCols.map(c=>{const f=freq(c.values,1);if(!f.length)return null;return{col:c,top:f[0][0],pct:f[0][1]/rowCount*100};}).filter(x=>x&&x.pct>=60).sort((a,b)=>b.pct-a.pct)[0];
  if(dominant){
    out.push({sev:'warn',tag:'Category skew',text:`<b>${esc(String(dominant.top))}</b> accounts for <b>${dominant.pct.toFixed(0)}%</b> of <b>${esc(dominant.col.name)}</b>. Other values may be under-represented or worth segmenting separately.`});
  }
  // WARN: numeric column with high outlier ratio
  for(const c of numCols){
    if(!c.stats)continue;
    const iqr=c.stats.q3-c.stats.q1;
    if(iqr<=0)continue;
    const lo=c.stats.q1-1.5*iqr,hi=c.stats.q3+1.5*iqr;
    const out_n=c.nums.filter(v=>!isNaN(v)&&(v<lo||v>hi)).length;
    if(out_n>0&&out_n/c.nums.length>=0.05){
      out.push({sev:'warn',tag:'Outliers',text:`<b>${esc(c.name)}</b> has <b>${out_n} outliers</b> (${(out_n/c.nums.length*100).toFixed(0)}% of values). They could be real extremes or data-entry errors — worth a check.`});
      break;
    }
  }
  // GOOD: high completeness
  if(completeness>=95&&dupes/rowCount<0.02){
    out.push({sev:'good',tag:'Clean data',text:`Your dataset is <b>${completeness.toFixed(0)}% complete</b> with almost no duplicates. This is a strong foundation for automated reporting.`});
  }else if(health>=80){
    out.push({sev:'good',tag:'Healthy',text:`Overall data quality score: <b>${health}/100</b>. Ready to feed into an automated dashboard with minimal cleanup.`});
  }
  // GOOD: time span
  const dateCol=dateCol0(cols);
  if(dateCol){
    const dates=dateCol.values.map(v=>Date.parse(v)).filter(v=>!isNaN(v)).sort((a,b)=>a-b);
    if(dates.length>=2){
      const days=Math.round((dates[dates.length-1]-dates[0])/86400000);
      if(days>=60)out.push({sev:'good',tag:'Trend-ready',text:`Data spans <b>${days} days</b> — long enough to track real trends and compare period-over-period.`});
    }
  }
  return out.slice(0,4);
}

// ---------- OUTLIER DETECTION ----------
function detectOutliers(numCols,data,headers){
  const found=[];
  for(const c of numCols){
    if(!c.stats)continue;
    const iqr=c.stats.q3-c.stats.q1;
    if(iqr<=0)continue;
    const lo=c.stats.q1-1.5*iqr,hi=c.stats.q3+1.5*iqr;
    let extreme=null,extremeDelta=0;
    data.forEach((row,idx)=>{
      const v=toNum(row[c.name]);
      if(isNaN(v))return;
      if(v<lo||v>hi){
        const delta=Math.abs(v-c.stats.median)/(c.stats.std||1);
        if(delta>extremeDelta){extremeDelta=delta;extreme={col:c,value:v,row:idx,delta,direction:v>hi?'hi':'lo'};}
      }
    });
    if(extreme)found.push(extreme);
  }
  return found.sort((a,b)=>b.delta-a.delta).slice(0,3);
}

// ---------- AUTOMATION-VALUE ESTIMATE ----------
function estimateAutomationValue(rowCount,cols,numCols,health,dupes){
  // Heuristic: a manual weekly report on this dataset typically takes
  // 30 minutes for small/clean data, scaling up with size + complexity.
  // We translate that to annualised hours and a blended hourly rate.
  const sizeFactor=rowCount<500?1:rowCount<5000?2:rowCount<50000?3.5:5;
  const complexityFactor=Math.min(2.5,1+cols.length/15+numCols.length/20);
  const qualityFactor=health<55?2.2:health<75?1.5:1; // dirtier data = more cleanup
  const dupeFactor=dupes>0?1.2:1;
  const weeklyMinutes=Math.round(30*sizeFactor*complexityFactor*qualityFactor*dupeFactor);
  const weeklyHours=+(weeklyMinutes/60).toFixed(1);
  const annualHours=Math.round(weeklyHours*48);
  const hourlyRate=45;
  const annualCost=Math.round(annualHours*hourlyRate);
  return{weeklyMinutes,weeklyHours,annualHours,annualCost};
}

function execSummary(cols,numCols,catCols,dateCol,rowCount,completeness,dupes,health,fname){
  const parts=[];
  // 1. What this dataset is
  const shape=`This dataset contains <b>${rowCount.toLocaleString()} rows</b> across <b>${cols.length} columns</b>`;
  const makeup=[];
  if(numCols.length)makeup.push(`${numCols.length} numeric`);
  if(catCols.length)makeup.push(`${catCols.length} categorical`);
  if(dateCol)makeup.push(`1 date`);
  const textCols=cols.filter(c=>c.type==='text').length;
  if(textCols)makeup.push(`${textCols} text`);
  parts.push(`${shape}${makeup.length?` — <span class="es-cyan">${makeup.join(', ')}</span> field${makeup.length>1?'s':''}`:''}.`);

  // 2. Time span (if dated)
  if(dateCol){
    const dates=dateCol.values.map(v=>Date.parse(v)).filter(v=>!isNaN(v)).sort((a,b)=>a-b);
    if(dates.length>1){
      const span=(dates[dates.length-1]-dates[0])/(1000*60*60*24);
      const fmt=ms=>new Date(ms).toLocaleDateString('en-US',{month:'short',year:'numeric'});
      parts.push(`It spans <b>${fmt(dates[0])} to ${fmt(dates[dates.length-1])}</b> (${Math.round(span)} days), so trends over time can be tracked.`);
    }
  }

  // 3. The standout numeric field (highest total / most meaningful)
  if(numCols.length){
    // pick the numeric col with the largest magnitude mean as the "headline metric"
    const headline=numCols.slice().sort((a,b)=>(Math.abs(b.stats?b.stats.mean:0))-(Math.abs(a.stats?a.stats.mean:0)))[0];
    if(headline&&headline.stats){
      const s=headline.stats;
      const total=s.mean*s.count;
      parts.push(`The key metric appears to be <b>${esc(headline.name)}</b>, averaging <span class="es-cyan">${fmt(s.mean)}</span> per row (ranging ${fmt(s.min)}–${fmt(s.max)}${Math.abs(total)>1000?`, totalling ~${fmt(total)}`:''}).`);
    }
  }

  // 4. Dominant category
  if(catCols.length){
    const c=catCols.slice().sort((a,b)=>a.uniq-b.uniq)[0];
    const f=freq(c.values,99);
    if(f.length){
      const pct=(f[0][1]/rowCount*100).toFixed(0);
      parts.push(`Within <b>${esc(c.name)}</b>, the data is led by <b>"${esc(f[0][0])}"</b> (${pct}% of rows)${c.uniq>1?` across ${c.uniq} distinct values`:''}.`);
    }
  }

  // 5. Strongest relationship
  let best=null;
  for(let i=0;i<numCols.length;i++)for(let j=i+1;j<numCols.length;j++){
    const r=pearson(numCols[i].nums,numCols[j].nums);
    if(r!==null&&(!best||Math.abs(r)>Math.abs(best.r)))best={a:numCols[i].name,b:numCols[j].name,r};
  }
  if(best&&Math.abs(best.r)>0.5){
    parts.push(`Notably, <b>${esc(best.a)}</b> and <b>${esc(best.b)}</b> are strongly ${best.r>0?'positively':'negatively'} correlated (r=${best.r.toFixed(2)}) — a relationship worth acting on.`);
  }

  // 6. Data quality verdict
  if(health>=80){
    parts.push(`<b>Bottom line:</b> the data is clean and well-structured (${completeness.toFixed(0)}% complete${dupes?`, though ${dupes} duplicate row${dupes>1?'s':''} should be removed`:''}) — it's ready to plug straight into an automated reporting pipeline.`);
  }else if(health>=55){
    parts.push(`<b>Bottom line:</b> the data is usable but needs some cleanup first (${completeness.toFixed(0)}% complete${dupes?`, ${dupes} duplicate${dupes>1?'s':''}`:''}) before it's reliable enough to automate.`);
  }else{
    parts.push(`<b>Bottom line:</b> the foundations need work (${completeness.toFixed(0)}% complete${dupes?`, ${dupes} duplicate${dupes>1?'s':''}`:''}) — fixing data quality here is the highest-value first step before any automation.`);
  }

  return parts.join(' ');
}

function buildInsights(cols,numCols,catCols,dupes,rowCount,completeness){
  const out=[];
  // strongest correlation
  let best=null;
  for(let i=0;i<numCols.length;i++)for(let j=i+1;j<numCols.length;j++){
    const r=pearson(numCols[i].nums,numCols[j].nums);
    if(r!==null&&(!best||Math.abs(r)>Math.abs(best.r)))best={a:numCols[i].name,b:numCols[j].name,r};
  }
  if(best&&Math.abs(best.r)>0.5){
    out.push({t:'info',ic:'🔗',x:`<b>${esc(best.a)}</b> and <b>${esc(best.b)}</b> move ${best.r>0?'together':'inversely'} (correlation ${best.r.toFixed(2)}). ${best.r>0?'As one rises, so does the other.':'As one rises, the other tends to fall.'} Worth investigating as a driver.`});
  }
  // biggest category
  if(catCols.length){
    const c=catCols[0];const f=freq(c.values,99);const top=f[0];
    if(top){const pct=(top[1]/rowCount*100).toFixed(0);out.push({t:'info',ic:'📊',x:`In <b>${esc(c.name)}</b>, "<b>${esc(top[0])}</b>" is the most common value at ${pct}% of rows.`});}
  }
  // missing data
  const worst=cols.filter(c=>c.missingPct>0).sort((a,b)=>b.missingPct-a.missingPct)[0];
  if(worst&&worst.missingPct>=10){
    out.push({t:'warn',ic:'⚠️',x:`<b>${esc(worst.name)}</b> is missing ${worst.missingPct.toFixed(0)}% of its values. That gap will quietly distort any report built on this column until it's fixed.`});
  }else if(completeness>=99){
    out.push({t:'good',ic:'✅',x:`Your data is <b>${completeness.toFixed(0)}% complete</b> — almost no gaps. That's a great foundation for automated reporting.`});
  }
  // duplicates
  if(dupes>0){out.push({t:'warn',ic:'🔁',x:`Found <b>${dupes} duplicate row${dupes>1?'s':''}</b>. Duplicates inflate totals — deduplication should happen before any numbers are trusted.`});}
  // high-value numeric
  if(numCols.length){
    const c=numCols.map(c=>({c,cv:c.stats?c.stats.std/(Math.abs(c.stats.mean)||1):0})).sort((a,b)=>b.cv-a.cv)[0].c;
    if(c.stats)out.push({t:'info',ic:'📈',x:`<b>${esc(c.name)}</b> ranges from ${fmt(c.stats.min)} to ${fmt(c.stats.max)} (avg ${fmt(c.stats.mean)}). The wide spread suggests this is where the interesting variation lives.`});
  }
  // outliers (values beyond 1.5*IQR — the standard outlier test)
  for(const c of numCols){
    if(!c.stats)continue;
    const iqr=c.stats.q3-c.stats.q1;
    if(iqr<=0)continue;
    const lo=c.stats.q1-1.5*iqr, hi=c.stats.q3+1.5*iqr;
    const outliers=c.nums.filter(v=>!isNaN(v)&&(v<lo||v>hi)).length;
    if(outliers>0&&outliers/c.stats.count<0.15){
      out.push({t:'warn',ic:'🎯',x:`<b>${esc(c.name)}</b> has <b>${outliers} outlier${outliers>1?'s':''}</b> — value${outliers>1?'s':''} far outside the typical range. These can skew averages and are worth checking (real extremes, or data-entry errors?).`});
      break; // only report the first/most relevant
    }
  }
  // near-constant column (almost no variation = often useless or an entry problem)
  for(const c of cols){
    if(c.type==='number'||c.type==='categorical'){
      const f=freq(c.values,1);
      if(f.length&&f[0][1]/rowCount>=0.97&&c.uniq<=2){
        out.push({t:'info',ic:'📌',x:`<b>${esc(c.name)}</b> is almost entirely one value ("${esc(f[0][0])}"). A column with no variation rarely adds insight — consider dropping it or checking why it's not being captured.`});
        break;
      }
    }
  }
  if(!out.length)out.push({t:'info',ic:'💡',x:`Upload a richer dataset with numeric and category columns to unlock correlations and trend detection.`});
  return out.slice(0,6);
}

function healthMsg(h,miss,dupes,rows,cols){
  const bits=[];
  if(miss===0)bits.push('no missing values');else bits.push(`${miss} missing value${miss>1?'s':''}`);
  if(dupes>0)bits.push(`${dupes} duplicate row${dupes>1?'s':''}`);
  if(cols.some(c=>c.type==='date'))bits.push('a usable date column for trends');
  return`Based on completeness, duplicates, and structure: ${bits.join(', ')}. ${h>=80?'This is in good shape to plug into an automated pipeline.':h>=55?'Some cleanup will make automation far more reliable.':'Fixing the foundations here is the highest-value first step.'}`;
}

function corrColor(v){
  // v in [-1,1]; positive cyan, negative rose
  const a=Math.min(1,Math.abs(v));
  if(v>=0)return`rgba(0,212,255,${0.12+a*0.78})`;
  return`rgba(251,113,133,${0.12+a*0.78})`;
}
function short(s){return s.length>10?s.slice(0,9)+'…':s;}
function fmt(n){if(n==null||isNaN(n))return'–';const a=Math.abs(n);if(a>=1e6)return(n/1e6).toFixed(1)+'M';if(a>=1e3)return(n/1e3).toFixed(1)+'k';if(a<1&&a>0)return n.toFixed(2);return n.toFixed(a<100?1:0);}
function fmtCell(v){if(v===null||v===undefined||String(v).trim()==='')return'—';return String(v);}
function esc(s){return String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}

function resetTool(){
  dashCharts.forEach(c=>{try{c.destroy();}catch(e){}});dashCharts=[];
  if(DASH)DASH.filters={};
  results.style.display='none';results.innerHTML='';
  $('introBlock').style.display='block';drop.style.display='block';
  fileInput.value='';clearErr();
  window.scrollTo({top:0,behavior:'smooth'});
}
</script>
</body>
</html>
